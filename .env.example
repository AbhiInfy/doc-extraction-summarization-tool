# Optional. Used to write a client-ready PowerPoint briefing.
# Lookup order: ANTHROPIC, then OPENAI, then GROQ. First working key wins.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (console.groq.com). Keys start with gsk_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Free tier is 8000 tokens per request. Raise this after a Groq Dev Tier upgrade.
# GROQ_TOKEN_LIMIT=8000

# Fusion BI Publisher Module Implemented report. Used when the Streamlit app starts.
FUSION_BASE_URL=https://ehzq-test.fa.us2.oraclecloud.com
FUSION_USERNAME=
FUSION_PASSWORD=
FUSION_BIP_REPORT_PATH=/Custom/Module Implemented Report.xdo
# FUSION_USERNAME is the Fusion login user (for example john.doe), not the environment URL.
